{
  "name": "loteria",
  "version": "0.0.0",
  "private": true,
  "description": "Multiplayer Lotería: a caller draws cards, players mark their tablas on their phones and call LOTERÍA",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/server",
    "packages/web"
  ],
  "scripts": {
    "dev": "tsc --build && node packages/server/dist/main.js --dev",
    "build": "tsc --build && npm run build:app -w @loteria/web",
    "start": "node packages/server/dist/main.js",
    "test": "tsc --build && npm run test --workspaces --if-present",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "prettier": "3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
